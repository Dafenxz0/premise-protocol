{
  "name": "@premise/premise-server",
  "version": "0.1.0-rc.1",
  "description": "Small HTTP server for PREMiSE operations.",
  "type": "module",
  "dependencies": {
    "@premise/context-engine": "workspace:*",
    "@premise/index-hybrid": "workspace:*",
    "@premise/protocol-types": "workspace:*",
    "@premise/reference-ts": "workspace:*",
    "@premise/runtime-core": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node test/http.test.mjs && node test/v2.test.mjs"
  }
}
