{
  "name": "@premise/validator-github",
  "version": "0.1.0-rc.1",
  "description": "PREMiSE GitHub REST and webhook validator.",
  "type": "module",
  "dependencies": {
    "@premise/protocol-types": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
