{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://premise.dev/spec/premise-guard-1/contract.schema.json",
  "title": "PREMiSE Guard premise-guard/1 contract",
  "description": "Wire messages for action-bound validation, receipts and atomic conditional actions.",
  "oneOf": [
    { "$ref": "#/$defs/guardIntent" },
    { "$ref": "#/$defs/guardReceipt" },
    { "$ref": "#/$defs/conditionalAction" },
    { "$ref": "#/$defs/actionResult" },
    { "$ref": "#/$defs/guardCapabilities" }
  ],
  "$defs": {
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fenceToken": {
      "type": "integer",
      "minimum": 1
    },
    "sourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUri", "scheme", "token", "observedAt", "validatorId"],
      "properties": {
        "sourceUri": { "$ref": "#/$defs/id" },
        "scheme": { "$ref": "#/$defs/id" },
        "token": { "$ref": "#/$defs/id" },
        "observedAt": { "$ref": "#/$defs/dateTime" },
        "validatorId": { "$ref": "#/$defs/id" }
      }
    },
    "sourceCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUri", "scheme", "token"],
      "properties": {
        "sourceUri": { "$ref": "#/$defs/id" },
        "scheme": { "$ref": "#/$defs/id" },
        "token": { "$ref": "#/$defs/id" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "kind", "target", "requestDigest"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "requestDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaseId", "scope", "fenceToken", "expiresAt"],
      "properties": {
        "leaseId": { "$ref": "#/$defs/id" },
        "scope": { "$ref": "#/$defs/id" },
        "fenceToken": { "$ref": "#/$defs/fenceToken" },
        "expiresAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "sliceMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryId", "incarnation", "revision", "status", "dependsOn", "sourceVersions"],
      "properties": {
        "memoryId": { "$ref": "#/$defs/id" },
        "incarnation": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/id" },
        "status": { "const": "FRESH" },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "sourceVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceVersion" }
        }
      }
    },
    "sliceResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "incarnation", "revision"],
      "properties": {
        "resourceId": { "$ref": "#/$defs/id" },
        "incarnation": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/id" }
      }
    },
    "criticalSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "rootMemoryIds", "memories", "resources", "digest"],
      "properties": {
        "complete": { "const": true },
        "rootMemoryIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "memories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sliceMemory" }
        },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sliceResource" }
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "expectedMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryId", "incarnation", "revision"],
      "properties": {
        "memoryId": { "$ref": "#/$defs/id" },
        "incarnation": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/id" }
      }
    },
    "expectedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "incarnation", "revision"],
      "properties": {
        "resourceId": { "$ref": "#/$defs/id" },
        "incarnation": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/id" }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sliceDigest", "memories", "sources", "resources", "fenceToken"],
      "properties": {
        "sliceDigest": { "$ref": "#/$defs/digest" },
        "memories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/expectedMemory" }
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceCondition" }
        },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/expectedResource" }
        },
        "fenceToken": { "$ref": "#/$defs/fenceToken" }
      }
    },
    "receiptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "receiptDigest", "intentDigest", "actionDigest", "sliceDigest", "leaseId", "fenceToken"],
      "properties": {
        "receiptId": { "$ref": "#/$defs/id" },
        "receiptDigest": { "$ref": "#/$defs/digest" },
        "intentDigest": { "$ref": "#/$defs/digest" },
        "actionDigest": { "$ref": "#/$defs/digest" },
        "sliceDigest": { "$ref": "#/$defs/digest" },
        "leaseId": { "$ref": "#/$defs/id" },
        "fenceToken": { "$ref": "#/$defs/fenceToken" }
      }
    },
    "conflictObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapterId", "observedAt", "slice"],
      "properties": {
        "adapterId": { "$ref": "#/$defs/id" },
        "observedAt": { "$ref": "#/$defs/dateTime" },
        "slice": { "$ref": "#/$defs/criticalSlice" }
      }
    },
    "guardIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "specVersion", "tenantId", "intentId", "idempotencyKey", "action", "memoryIds", "requestedAt"],
      "properties": {
        "kind": { "const": "GuardIntent" },
        "specVersion": { "const": "premise-guard/1" },
        "tenantId": { "$ref": "#/$defs/id" },
        "intentId": { "$ref": "#/$defs/id" },
        "idempotencyKey": { "$ref": "#/$defs/id" },
        "action": { "$ref": "#/$defs/action" },
        "memoryIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "requestedAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "guardReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "specVersion", "tenantId", "receiptId", "intentId", "idempotencyKey", "intentDigest", "actionDigest", "sliceDigest", "decision", "slice", "issuedAt", "expiresAt", "lease", "receiptDigest"],
      "properties": {
        "kind": { "const": "GuardReceipt" },
        "specVersion": { "const": "premise-guard/1" },
        "tenantId": { "$ref": "#/$defs/id" },
        "receiptId": { "$ref": "#/$defs/id" },
        "intentId": { "$ref": "#/$defs/id" },
        "idempotencyKey": { "$ref": "#/$defs/id" },
        "intentDigest": { "$ref": "#/$defs/digest" },
        "actionDigest": { "$ref": "#/$defs/digest" },
        "sliceDigest": { "$ref": "#/$defs/digest" },
        "decision": { "const": "USE" },
        "slice": { "$ref": "#/$defs/criticalSlice" },
        "issuedAt": { "$ref": "#/$defs/dateTime" },
        "expiresAt": { "$ref": "#/$defs/dateTime" },
        "lease": { "$ref": "#/$defs/lease" },
        "receiptDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "conditionalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "specVersion", "tenantId", "intentId", "idempotencyKey", "action", "receipt", "conditions", "submittedAt", "adapterId"],
      "properties": {
        "kind": { "const": "ConditionalAction" },
        "specVersion": { "const": "premise-guard/1" },
        "tenantId": { "$ref": "#/$defs/id" },
        "intentId": { "$ref": "#/$defs/id" },
        "idempotencyKey": { "$ref": "#/$defs/id" },
        "action": { "$ref": "#/$defs/action" },
        "receipt": { "$ref": "#/$defs/receiptBinding" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "submittedAt": { "$ref": "#/$defs/dateTime" },
        "adapterId": { "$ref": "#/$defs/id" }
      }
    },
    "appliedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "specVersion", "tenantId", "intentId", "idempotencyKey", "actionDigest", "status", "effects", "resultDigest", "committedAt"],
      "properties": {
        "kind": { "const": "ActionResult" },
        "specVersion": { "const": "premise-guard/1" },
        "tenantId": { "$ref": "#/$defs/id" },
        "intentId": { "$ref": "#/$defs/id" },
        "idempotencyKey": { "$ref": "#/$defs/id" },
        "actionDigest": { "$ref": "#/$defs/digest" },
        "status": { "const": "APPLIED" },
        "effects": { "const": 1 },
        "resultDigest": { "$ref": "#/$defs/digest" },
        "committedAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "replayResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "specVersion", "tenantId", "intentId", "idempotencyKey", "actionDigest", "status", "effects", "resultDigest", "committedAt"],
      "properties": {
        "kind": { "const": "ActionResult" },
        "specVersion": { "const": "premise-guard/1" },
        "tenantId": { "$ref": "#/$defs/id" },
        "intentId": { "$ref": "#/$defs/id" },
        "idempotencyKey": { "$ref": "#/$defs/id" },
        "actionDigest": { "$ref": "#/$defs/digest" },
        "status": { "const": "REPLAY" },
        "effects": { "const": 0 },
        "resultDigest": { "$ref": "#/$defs/digest" },
        "committedAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "rejectedResult": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "required": ["conflictObservation"] },
          "then": { "properties": { "reason": { "enum": ["CAS_MISMATCH", "SOURCE_CHANGED", "INCARNATION_MISMATCH"] } } }
        }
      ],
      "required": ["kind", "specVersion", "tenantId", "intentId", "idempotencyKey", "actionDigest", "status", "reason", "effects"],
      "properties": {
        "kind": { "const": "ActionResult" },
        "specVersion": { "const": "premise-guard/1" },
        "tenantId": { "$ref": "#/$defs/id" },
        "intentId": { "$ref": "#/$defs/id" },
        "idempotencyKey": { "$ref": "#/$defs/id" },
        "actionDigest": { "$ref": "#/$defs/digest" },
        "status": { "const": "REJECTED" },
        "reason": {
          "enum": [
            "CAS_REQUIRED",
            "CAS_MISMATCH",
            "SOURCE_CHANGED",
            "INCARNATION_MISMATCH",
            "RECEIPT_EXPIRED",
            "LEASE_EXPIRED",
            "FENCE_STALE",
            "SLICE_INCOMPLETE",
            "RECEIPT_BINDING_MISMATCH",
            "IDEMPOTENCY_CONFLICT",
            "NOT_FOUND"
          ]
        },
        "conflictObservation": { "$ref": "#/$defs/conflictObservation" },
        "effects": { "const": 0 }
      }
    },
    "actionResult": {
      "oneOf": [
        { "$ref": "#/$defs/appliedResult" },
        { "$ref": "#/$defs/replayResult" },
        { "$ref": "#/$defs/rejectedResult" }
      ]
    },
    "guardCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "specVersion", "adapterId", "capabilities", "announcedAt"],
      "properties": {
        "kind": { "const": "GuardCapabilities" },
        "specVersion": { "const": "premise-guard/1" },
        "adapterId": { "$ref": "#/$defs/id" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["CAS", "IDEMPOTENCY", "FENCING"] }
        },
        "announcedAt": { "$ref": "#/$defs/dateTime" }
      }
    }
  }
}
