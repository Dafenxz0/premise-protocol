{
  "format": "premise-guard-test-vector/1",
  "specVersion": "premise-guard/1",
  "vectorId": "idempotent-replay-and-conflict",
  "category": "transition",
  "description": "El mismo intent se aplica una vez, se repite sin efecto y no puede cambiar de acción con la misma clave.",
  "initial": {
    "now": "2026-08-12T16:00:00Z",
    "adapter": {
      "adapterId": "adapter:cas",
      "capabilities": ["CAS", "IDEMPOTENCY", "FENCING"]
    },
    "memories": [
      {
        "memoryId": "memory:answer",
        "incarnation": "memory:answer#1",
        "revision": "r1",
        "status": "FRESH",
        "dependsOn": [],
        "sourceVersions": []
      }
    ],
    "resources": [
      {
        "resourceId": "resource:order:1",
        "incarnation": "order:1",
        "revision": "r7"
      }
    ],
    "lease": {
      "leaseId": "lease:7",
      "scope": "resource:order:1",
      "fenceToken": 13,
      "expiresAt": "2026-08-12T16:10:00Z"
    }
  },
  "steps": [
    {
      "id": "validate-once",
      "operation": "validate",
      "input": {
        "intentId": "intent:replay:1",
        "tenantId": "tenant:example",
        "idempotencyKey": "idem:replay:1",
        "memoryIds": ["memory:answer"],
        "actionDigest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
      },
      "expect": { "decision": "USE", "receipt": "receipt:replay:1" }
    },
    {
      "id": "commit-first",
      "operation": "commit",
      "input": { "receipt": "receipt:replay:1" },
      "expect": {
        "status": "APPLIED",
        "effects": 1,
        "idempotency": "NEW"
      }
    },
    {
      "id": "commit-replay",
      "operation": "commit",
      "input": { "receipt": "receipt:replay:1" },
      "expect": {
        "status": "REPLAY",
        "effects": 0,
        "idempotency": "REPLAY",
        "sameResultAs": "commit-first"
      }
    },
    {
      "id": "different-action-same-key",
      "operation": "commit",
      "input": {
        "idempotencyKey": "idem:replay:1",
        "actionDigest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
      },
      "expect": {
        "status": "REJECTED",
        "reason": "IDEMPOTENCY_CONFLICT",
        "effects": 0
      }
    }
  ]
}
