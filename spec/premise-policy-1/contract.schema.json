{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://premise.dev/spec/premise-policy-1/contract.schema.json",
  "title":"PREMiSE premise-policy/1 contract",
  "type":"object",
  "additionalProperties":false,
  "required":["specVersion","requested","available"],
  "properties":{
    "specVersion":{"const":"premise-policy/1"},
    "requested":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "available":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "requiredEvidence":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "risk":{"enum":["LOW","MEDIUM","HIGH","CRITICAL"]},
    "sharingKey":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "sharingScope":{
      "type":"object",
      "additionalProperties":false,
      "required":["tenantId","resourceId","incarnationId","versionToken","scopes","queryDigest","validatorId","authorizationContextDigest","policyDigest","changeSetDigest","causalFrontier"],
      "properties":{
        "tenantId":{"type":"string","minLength":1},
        "resourceId":{"type":"string","minLength":1},
        "incarnationId":{"type":"string","minLength":1},
        "versionToken":{"type":"string","minLength":1},
        "scopes":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "queryDigest":{"type":"string","minLength":1},
        "validatorId":{"type":"string","minLength":1},
        "authorizationContextDigest":{"type":"string","minLength":1},
        "policyDigest":{"type":"string","minLength":1},
        "changeSetDigest":{"type":["string","null"],"minLength":1},
        "causalFrontier":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "lease":{"type":"object","additionalProperties":false,"required":["leaseId","fencingToken","expiresAt"],"properties":{"leaseId":{"type":"string","minLength":1},"fencingToken":{"type":"string","minLength":1},"expiresAt":{"type":"string","format":"date-time"}}}
  }
}
