{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://premise.dev/spec/ga-api/schemas/error.schema.json",
  "title": "PREMiSE API error",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {
              "type": "array"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7e]+$"
    },
    "details": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
