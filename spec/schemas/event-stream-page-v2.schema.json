{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://premise.dev/spec/2/event-stream-page.schema.json",
  "title": "PREMiSE v2 event stream page",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "tenantId", "streamId", "events", "headSequence"],
  "properties": {
    "specVersion": { "const": "premise/2" },
    "tenantId": { "type": "string", "minLength": 1 },
    "streamId": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "items": { "$ref": "./premise-event-stream-v2.schema.json" }
    },
    "headSequence": { "type": "integer", "minimum": 0 },
    "nextCursor": { "type": "string", "minLength": 1 }
  }
}
