{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://premise.dev/spec/2/premise-event-stream.schema.json",
  "title": "PREMiSE v2 ordered stream event",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "tenantId", "eventId", "operationId", "idempotencyKey", "requestDigest", "type", "occurredAt", "payload", "streamId", "sequence", "kind"],
  "properties": {
    "specVersion": { "const": "premise/2" },
    "tenantId": { "type": "string", "minLength": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "operationId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "requestDigest": { "type": "string", "pattern": "^sha256:.+$" },
    "type": { "enum": ["MemoryRegistered", "MemoryDerived", "SourceChanged", "MemoryStaled", "MemoryInvalidated", "MemoryRevalidated", "MemoryReplaced", "ConflictDetected", "ConflictResolved", "MemoryMigrated"] },
    "occurredAt": { "type": "string", "format": "date-time" },
    "memoryId": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" },
    "streamId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "kind": { "enum": ["SNAPSHOT", "DELTA"] },
    "cursor": { "type": "string", "minLength": 1 },
    "sourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "token"],
      "properties": {
        "scheme": { "type": "string", "minLength": 1 },
        "token": { "type": "string", "minLength": 1 }
      }
    }
  }
}
