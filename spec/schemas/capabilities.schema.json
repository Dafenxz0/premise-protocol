{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://premise.dev/schemas/capabilities.schema.json",
  "title": "PREMiSE v0.1 capabilities",
  "description": "Independent capabilities declared by an implementation and the minimum compatibility profile.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "specVersion": {
      "const": "premise/0.1"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "profile": {
      "enum": [
        "PREMiSE-compatible v0.1"
      ]
    }
  },
  "required": [
    "specVersion",
    "capabilities",
    "profile"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "allOf": [
              {
                "contains": {
                  "const": "RECORD"
                }
              },
              {
                "contains": {
                  "const": "DEPENDENCY"
                }
              },
              {
                "contains": {
                  "const": "REVALIDATION"
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "capability": {
      "enum": [
        "RECORD",
        "DEPENDENCY",
        "REVALIDATION",
        "RETRIEVAL",
        "GATE"
      ]
    }
  }
}
