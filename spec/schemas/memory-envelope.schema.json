{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://premise.dev/schemas/memory-envelope.schema.json",
  "title": "PREMiSE v0.1 memory envelope",
  "description": "Metadata that describes the provenance, validity, and dependencies of a memory without carrying its content.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "specVersion": {
      "const": "premise/0.1"
    },
    "memoryId": {
      "$ref": "#/$defs/memoryId"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:.+$"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceReference"
      }
    },
    "validity": {
      "$ref": "#/$defs/validity"
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/memoryId"
      }
    }
  },
  "required": [
    "specVersion",
    "memoryId",
    "validity",
    "dependsOn"
  ],
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "provenance"
          ]
        },
        {
          "properties": {
            "dependsOn": {
              "minItems": 1
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "validity": {
            "properties": {
              "policy": {
                "const": "VERSIONED"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "provenance"
        ],
        "properties": {
          "provenance": {
            "items": {
              "required": [
                "version",
                "validator"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "memoryId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "type": "string",
          "minLength": 1
        },
        "token": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scheme",
        "token"
      ]
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "operation"
      ]
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceUri": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "validator": {
          "$ref": "#/$defs/validator"
        }
      },
      "required": [
        "sourceUri",
        "observedAt"
      ],
      "anyOf": [
        {
          "required": [
            "version",
            "validator"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "version"
                ]
              },
              {
                "required": [
                  "validator"
                ]
              }
            ]
          }
        }
      ]
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "FRESH",
            "STALE",
            "INVALID",
            "UNKNOWN"
          ]
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "policy": {
          "enum": [
            "IMMUTABLE",
            "VERSIONED",
            "TTL",
            "MANUAL"
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "status",
        "checkedAt",
        "policy"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "const": "TTL"
              }
            }
          },
          "then": {
            "required": [
              "expiresAt"
            ]
          }
        },
        {
          "if": {
            "required": [
              "expiresAt"
            ]
          },
          "then": {
            "properties": {
              "policy": {
                "const": "TTL"
              }
            }
          }
        }
      ]
    }
  }
}
