PREMISE_ENV=staging
PREMISE_STORE_MODE=postgres
PREMISE_IMAGE=__INJECT_APPLICATION_IMAGE_DIGEST__
PREMISE_POSTGRES_IMAGE=__INJECT_POSTGRES_IMAGE_DIGEST__
PREMISE_PROMETHEUS_IMAGE=__INJECT_PROMETHEUS_IMAGE_DIGEST__
PREMISE_OTEL_IMAGE=__INJECT_OTEL_IMAGE_DIGEST__
PREMISE_NODE_BUILD_IMAGE=__INJECT_NODE_BUILD_IMAGE_DIGEST__
PREMISE_NODE_RUNTIME_IMAGE=__INJECT_NODE_RUNTIME_IMAGE_DIGEST__
PREMISE_TENANT_ID=__INJECT_TENANT_ID__
PREMISE_TABLE_PREFIX=premise_v2
PREMISE_MAX_BODY_BYTES=1048576
PREMISE_DB_POOL_SIZE=8
PREMISE_DB_USER=__INJECT_DB_APP_USER__
PREMISE_DB_PASSWORD=__INJECT_DB_APP_PASSWORD__
PREMISE_API_TOKEN=__INJECT_API_TOKEN__
PREMISE_METRICS_TOKEN=__INJECT_METRICS_TOKEN__
PREMISE_METRICS_TOKEN_FILE=__INJECT_METRICS_TOKEN_FILE__
PREMISE_REQUIRE_SIGNED_ENVELOPES=1
PREMISE_SIGNATURE_KEYS_FILE=/run/secrets/premise_signature_public_keys.json
DATABASE_URL=__INJECT_FROM_SECRET_MANAGER__
MIGRATIONS_DATABASE_URL=__INJECT_MIGRATIONS_FROM_SECRET_MANAGER__
OTEL_SERVICE_NAME=premise-v2-staging
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_PROPAGATORS=tracecontext,baggage
