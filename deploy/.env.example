# Copy this file to a local, untracked env file. Values here are for local
# development only; protected deployments must inject secrets externally.
PREMISE_ENV=development
# Required outside development. Use a high-entropy visible-ASCII token of at
# least 32 characters; inject it from a secret manager and never commit it.
PREMISE_API_TOKEN=
# Dedicated bearer for Prometheus; do not reuse the API token. Outside
# development it is required and must be high entropy. The same value must be
# written, one line only, to the Docker secret file below.
PREMISE_METRICS_TOKEN=local-only-metrics-token
PREMISE_METRICS_TOKEN_FILE=../.local/premise_metrics_token
PREMISE_IMAGE=premise-v2:local
PREMISE_POSTGRES_IMAGE=postgres:16.4-alpine
PREMISE_PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
PREMISE_OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.132.0
PREMISE_NODE_BUILD_IMAGE=node:24.19.0-bookworm-slim
PREMISE_NODE_RUNTIME_IMAGE=node:24.19.0-bookworm-slim
PREMISE_BUILD_VERSION=local
PREMISE_TENANT_ID=tenant:local
PREMISE_TABLE_PREFIX=premise_v2
# Optional local signature verification. The reference HTTP entrypoint refuses
# this outside development until a shared durable replay store is integrated;
# a mounted file is not KMS/HSM and must contain public keys only.
PREMISE_REQUIRE_SIGNED_ENVELOPES=0
# PREMISE_SIGNATURE_KEYS_FILE=/run/secrets/premise_signature_public_keys.json
# PREMISE_SIGNATURE_KEYS_SOURCE=../.local/premise_signature_public_keys.json
PREMISE_SIGNATURE_MAX_CLOCK_SKEW_MS=300000
POSTGRES_DB=premise
POSTGRES_USER=premise
POSTGRES_PASSWORD=local-only-not-for-production
PREMISE_DB_USER=premise_app
PREMISE_DB_PASSWORD=local-only-app-password
# Optional locally; production must inject a migration-owner URL separately.
# MIGRATIONS_DATABASE_URL=postgresql://premise:...@postgres:5432/premise
PREMISE_MAX_BODY_BYTES=1048576
PREMISE_RUNTIME_WRITE_CONCURRENCY=8
PREMISE_RUNTIME_MAX_PENDING_WRITES=10000
PREMISE_HTTP_IDEMPOTENCY_RETENTION_MS=604800000
PREMISE_HTTP_IDEMPOTENCY_CLEANUP_INTERVAL_MS=3600000
PREMISE_DB_POOL_SIZE=16
OTEL_SERVICE_NAME=premise-v2
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_PROPAGATORS=tracecontext,baggage

# For staging/production, inject DATABASE_URL from a secret manager at runtime.
# DATABASE_URL=__INJECT_AT_RUNTIME__
