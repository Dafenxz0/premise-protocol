{
  "name": "premise-protocol",
  "version": "2.0.0-rc.1",
  "private": true,
  "description": "PREMiSE protocol workspace with the additive v2 runtime and evaluation stack.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "pnpm run typecheck && pnpm --recursive --if-present test",
    "test:properties": "pnpm --filter @premise/testkit test",
    "conformance": "pnpm --filter @premise/conformance test",
    "conformance:premise1": "node conformance/run.mjs",
    "conformance:protocol": "node conformance/run.mjs && python -m unittest discover -s reference/python -p \"test_*.py\"",
    "protocol:self-check": "node scripts/protocol-evolution/self-check.mjs",
    "conformance:v2": "pnpm build && node scripts/verify-v2-vectors.mjs",
    "benchmark:smoke": "pnpm --filter @premise/benchmark benchmark:smoke",
    "benchmark": "pnpm --filter @premise/benchmark benchmark:smoke",
    "benchmark:real-world": "pnpm build && node benchmarks/real-world-bench/runner.mjs && node benchmarks/real-world-bench/self-check.mjs",
    "benchmark:context-corpus": "pnpm build && node benchmarks/context-corpus-bench/runner.mjs --profiles 1000,10000,50000 --max-ms 600000 && node benchmarks/context-corpus-bench/self-check.mjs",
    "benchmark:context-corpus:full": "pnpm build && node benchmarks/context-corpus-bench/runner.mjs --include-100k --max-ms 900000 && node benchmarks/context-corpus-bench/self-check.mjs && pnpm benchmark:tables",
    "benchmark:production": "pnpm benchmark:real-world && pnpm benchmark:context-corpus && pnpm benchmark:tables",
    "benchmark:tables": "node benchmarks/benchmark-report.mjs",
    "benchmark:compare": "pnpm build && node benchmarks/comparative-bench/runner.mjs && node benchmarks/comparative-bench/self-check.mjs",
    "benchmark:context": "pnpm build && node benchmarks/long-context-bench/runner.mjs --profiles 1000,5000 --max-ms 120000 && node benchmarks/long-context-bench/self-check.mjs",
    "benchmark:context:full": "pnpm build && node benchmarks/long-context-bench/runner.mjs --full --max-ms 120000 && node benchmarks/long-context-bench/self-check.mjs",
    "benchmark:evaluate": "node benchmarks/evaluation/runner.mjs",
    "benchmark:next": "pnpm benchmark:compare && pnpm benchmark:context:full && pnpm benchmark:real-world && pnpm benchmark:context-corpus:full && pnpm benchmark:evaluate",
    "benchmark:v2:offline": "node benchmarks/real-world-v2/runner.mjs --offline && node benchmarks/real-world-v2/report.mjs && node benchmarks/real-world-v2/self-check.mjs",
    "benchmark:v2:live": "node benchmarks/real-world-v2/runner.mjs --live && node benchmarks/real-world-v2/report.mjs && node benchmarks/real-world-v2/self-check.mjs",
    "benchmark:v2:giant": "node benchmarks/giant-context-v2/runner.mjs --profiles=10000,100000 && node benchmarks/giant-context-v2/self-check.mjs",
    "benchmark:v2:giant:full": "node benchmarks/giant-context-v2/runner.mjs --include-1m --profiles=100000,1000000 && node benchmarks/giant-context-v2/self-check.mjs",
    "benchmark:premisebench:smoke": "node benchmarks/premisebench-agent/runner.mjs --tasks=100 --seed=20260811",
    "benchmark:premisebench:self-check": "node benchmarks/premisebench-agent/self-check.mjs && node benchmarks/premisebench-agent/security/oracle-leakage.mjs && node scripts/premisebench-agent/check-artifacts.mjs && node scripts/premisebench-agent/check-claims.mjs",
    "benchmark:premisebench:mutation:100": "node benchmarks/premisebench-agent/mutation-campaign.mjs --tasks=100 --seed=20260811 --round=100-local",
    "benchmark:premisebench:mutation:200": "node benchmarks/premisebench-agent/mutation-campaign.mjs --tasks=200 --seed=20260812 --round=200-local",
    "benchmark:premisebench:mutation:test": "node --test benchmarks/premisebench-agent/mutation-campaign.test.mjs",
    "benchmark:premisebench:mutation:self-check": "node scripts/premisebench-agent/mutation-campaign-self-check.mjs --tasks=200 --round=200-local",
    "benchmark:scientific:mvp": "node benchmarks/premisebench-agent/scientific/runner.mjs --tasks=200 --seed=20260811 --round=scientific-mvp-dev",
    "benchmark:scientific:check": "node benchmarks/premisebench-agent/scientific/runner.mjs --tasks=200 --seed=20260811 --round=scientific-mvp-dev && node --test benchmarks/premisebench-agent/scientific/adversarial.test.mjs benchmarks/premisebench-agent/scientific/campaigns.test.mjs benchmarks/premisebench-agent/scientific/examiner.test.mjs benchmarks/premisebench-agent/scientific/frontier.test.mjs benchmarks/premisebench-agent/scientific/metrics.test.mjs benchmarks/premisebench-agent/scientific/matrix.test.mjs && node scripts/premisebench-agent/scientific-self-check.mjs --round=scientific-mvp-dev",
    "benchmark:scientific:matrix": "node benchmarks/premisebench-agent/scientific/matrix.mjs --tasks=20 --seed=20260811 --round=matrix-dev",
    "benchmark:scientific:matrix:check": "node benchmarks/premisebench-agent/scientific/matrix.mjs --tasks=20 --seed=20260811 --round=matrix-dev && node scripts/premisebench-agent/scientific-matrix-self-check.mjs --round=matrix-dev",
    "benchmark:protocol-evolution": "node benchmarks/protocol-evolution/runner.mjs",
    "benchmark:protocol-evolution:check": "node benchmarks/protocol-evolution/runner.mjs && node benchmarks/protocol-evolution/self-check.mjs",
    "benchmark:llm:check": "node --test benchmarks/premisebench-agent/llm/llm.test.mjs benchmarks/premisebench-agent/llm/campaign.test.mjs",
    "benchmark:llm:pilot": "node benchmarks/premisebench-agent/llm/campaign.mjs --provider=gemini --model=gemini-3.5-flash-lite --tasks=20 --seed=20260811 --round=gemini-pilot --max-retries=0 --delay-ms=2000",
    "benchmark:llm:ling-tiny": "node benchmarks/premisebench-agent/llm/campaign.mjs --provider=openrouter --model=inclusionai/ling-3.0-tiny:free --tasks=1 --scenario=standard --max-turns=4 --max-tokens=128 --max-retries=0 --max-provider-requests=12 --max-provider-tokens=24000 --min-request-interval-ms=5000 --response-format=none --round=ling-tiny-live",
    "benchmark:llm:nemotron-lightning": "node benchmarks/premisebench-agent/llm/campaign.mjs --provider=openrouter --model=nvidia/nemotron-3.5-lightning:free --tasks=1 --scenario=standard --max-turns=4 --max-tokens=128 --max-retries=0 --max-provider-requests=12 --max-provider-tokens=24000 --min-request-interval-ms=5000 --response-format=none --round=nemotron-lightning-live",
    "benchmark:hard:check": "node --test benchmarks/premisebench-agent/mutation-campaign.test.mjs benchmarks/premisebench-agent/scientific/hard-scenarios.test.mjs benchmarks/premisebench-agent/scientific/hard-ten-rounds.test.mjs benchmarks/premisebench-agent/llm/campaign.test.mjs && node benchmarks/premisebench-agent/scientific/hard-ten-rounds.mjs --start=1 --end=1 --skip-llm --llm-tasks=0 --output=.tmp/scientific-mvp/hard-check",
    "benchmark:hard:ten": "node benchmarks/premisebench-agent/scientific/hard-ten-rounds.mjs --llm-tasks=2 --provider=gemini --model=gemini-3.5-flash-lite",
    "benchmark:premisebench:live-smoke": "node benchmarks/premisebench-agent/live-smoke.mjs",
    "ga:gate": "node scripts/ga-gate.mjs",
    "ga:gate:strict": "node scripts/ga-gate.mjs --strict",
    "ga:evidence:collect": "node scripts/collect-ga-evidence.mjs",
    "ga:security": "pnpm --filter @premise/security-core test && node scripts/verify-security.mjs",
    "ga:connector": "pnpm --filter @premise/connector-webhook test",
    "ga:sdk": "pnpm --filter @premise/sdk test",
    "ga:evaluation": "node benchmarks/ga-evaluation/runner.mjs --split all && node benchmarks/ga-evaluation/self-check.mjs",
    "ga:holdout": "node benchmarks/ga-evaluation/holdout/runner.mjs",
    "ga:holdout:contract": "node benchmarks/ga-evaluation/holdout/contract.test.mjs",
    "ga:holdout:candidate:test": "pnpm build && node benchmarks/ga-evaluation/holdout/candidate.test.mjs",
    "ga:load": "node benchmarks/ga-load/runner.mjs --profile ci && node benchmarks/ga-load/self-check.mjs",
    "ga:soak": "node benchmarks/ga-soak/runner.mjs",
    "ga:soak:self-check": "node benchmarks/ga-soak/self-check.mjs",
    "ga:soak:diagnostic": "node benchmarks/ga-soak/diagnostic.mjs",
    "ga:cost": "node benchmarks/ga-cost/runner.mjs",
    "ga:cost:self-check": "node benchmarks/ga-cost/self-check.mjs",
    "ga:rollback:help": "node deploy/rollback-smoke.mjs --help",
    "ga:syntax": "node --check ops/auth.mjs && node ops/auth.test.mjs && node --test ops/server.routes.test.mjs && node --test ops/route-durability.test.mjs && node --check ops/backup.mjs && node --check ops/restore.mjs && node --check ops/healthcheck.mjs && node --check ops/smoke.mjs && node --check ops/postgres-settings.mjs && node --test ops/postgres-settings.test.mjs && node --check benchmarks/ga-soak/postgres-telemetry.mjs && node --check benchmarks/ga-soak/diagnostic.mjs && node --check benchmarks/ga-load/postgres-scale.mjs && node --check benchmarks/ga-load/signed-envelope-client.mjs && node --test benchmarks/ga-load/signed-envelope-client.test.mjs && node benchmarks/ga-load/postgres-scale.test.mjs && node benchmarks/ga-soak/self-check.mjs && node --test deploy/postgres-config.test.mjs",
    "examples:verify": "pnpm --filter @premise/example-generic-memory test && pnpm --filter @premise/example-openai-memory test && pnpm --filter @premise/example-mcp-memory test && node scripts/verify-adapters.mjs",
    "artifacts:generate": "pnpm build && node scripts/generate-artifacts.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
