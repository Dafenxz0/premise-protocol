{
  "name": "premise-protocol",
  "version": "2.0.0-rc.1",
  "private": true,
  "description": "PREMiSE protocol workspace with the additive v2 runtime and evaluation stack.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "pnpm run typecheck && pnpm --recursive --if-present test",
    "test:properties": "pnpm --filter @premise/testkit test",
    "conformance": "pnpm --filter @premise/conformance test",
    "conformance:v2": "pnpm build && node scripts/verify-v2-vectors.mjs",
    "benchmark:smoke": "pnpm --filter @premise/benchmark benchmark:smoke",
    "benchmark": "pnpm --filter @premise/benchmark benchmark:smoke",
    "benchmark:real-world": "pnpm build && node benchmarks/real-world-bench/runner.mjs && node benchmarks/real-world-bench/self-check.mjs",
    "benchmark:context-corpus": "pnpm build && node benchmarks/context-corpus-bench/runner.mjs --profiles 1000,10000,50000 --max-ms 600000 && node benchmarks/context-corpus-bench/self-check.mjs",
    "benchmark:context-corpus:full": "pnpm build && node benchmarks/context-corpus-bench/runner.mjs --include-100k --max-ms 900000 && node benchmarks/context-corpus-bench/self-check.mjs && pnpm benchmark:tables",
    "benchmark:production": "pnpm benchmark:real-world && pnpm benchmark:context-corpus && pnpm benchmark:tables",
    "benchmark:tables": "node benchmarks/benchmark-report.mjs",
    "benchmark:compare": "pnpm build && node benchmarks/comparative-bench/runner.mjs && node benchmarks/comparative-bench/self-check.mjs",
    "benchmark:context": "pnpm build && node benchmarks/long-context-bench/runner.mjs --profiles 1000,5000 --max-ms 120000 && node benchmarks/long-context-bench/self-check.mjs",
    "benchmark:context:full": "pnpm build && node benchmarks/long-context-bench/runner.mjs --full --max-ms 120000 && node benchmarks/long-context-bench/self-check.mjs",
    "benchmark:evaluate": "node benchmarks/evaluation/runner.mjs",
    "benchmark:next": "pnpm benchmark:compare && pnpm benchmark:context:full && pnpm benchmark:real-world && pnpm benchmark:context-corpus:full && pnpm benchmark:evaluate",
    "benchmark:v2:offline": "node benchmarks/real-world-v2/runner.mjs --offline && node benchmarks/real-world-v2/report.mjs && node benchmarks/real-world-v2/self-check.mjs",
    "benchmark:v2:live": "node benchmarks/real-world-v2/runner.mjs --live && node benchmarks/real-world-v2/report.mjs && node benchmarks/real-world-v2/self-check.mjs",
    "benchmark:v2:giant": "node benchmarks/giant-context-v2/runner.mjs --profiles=10000,100000 && node benchmarks/giant-context-v2/self-check.mjs",
    "benchmark:v2:giant:full": "node benchmarks/giant-context-v2/runner.mjs --include-1m --profiles=100000,1000000 && node benchmarks/giant-context-v2/self-check.mjs",
    "ga:gate": "node scripts/ga-gate.mjs",
    "ga:gate:strict": "node scripts/ga-gate.mjs --strict",
    "ga:evidence:collect": "node scripts/collect-ga-evidence.mjs",
    "ga:security": "pnpm --filter @premise/security-core test && node scripts/verify-security.mjs",
    "ga:connector": "pnpm --filter @premise/connector-webhook test",
    "ga:sdk": "pnpm --filter @premise/sdk test",
    "ga:evaluation": "node benchmarks/ga-evaluation/runner.mjs --split all && node benchmarks/ga-evaluation/self-check.mjs",
    "ga:holdout": "node benchmarks/ga-evaluation/holdout/runner.mjs",
    "ga:holdout:contract": "node benchmarks/ga-evaluation/holdout/contract.test.mjs",
    "ga:holdout:candidate:test": "pnpm build && node benchmarks/ga-evaluation/holdout/candidate.test.mjs",
    "ga:load": "node benchmarks/ga-load/runner.mjs --profile ci && node benchmarks/ga-load/self-check.mjs",
    "ga:soak": "node benchmarks/ga-soak/runner.mjs",
    "ga:soak:self-check": "node benchmarks/ga-soak/self-check.mjs",
    "ga:cost": "node benchmarks/ga-cost/runner.mjs",
    "ga:cost:self-check": "node benchmarks/ga-cost/self-check.mjs",
    "ga:rollback:help": "node deploy/rollback-smoke.mjs --help",
    "ga:syntax": "node --check ops/auth.mjs && node ops/auth.test.mjs && node --check ops/backup.mjs && node --check ops/restore.mjs && node --check ops/healthcheck.mjs && node --check ops/smoke.mjs",
    "examples:verify": "pnpm --filter @premise/example-generic-memory test && pnpm --filter @premise/example-openai-memory test && pnpm --filter @premise/example-mcp-memory test && node scripts/verify-adapters.mjs",
    "artifacts:generate": "pnpm build && node scripts/generate-artifacts.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
