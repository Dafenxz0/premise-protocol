{
  "name": "@premise/benchmark",
  "version": "0.1.0-rc.1",
  "description": "PREMiSE memory benchmark scaffold.",
  "type": "module",
  "dependencies": {
    "@premise/protocol-types": "workspace:*",
    "@premise/reference-ts": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "premise-benchmark": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node test/benchmark.test.mjs",
    "benchmark:smoke": "pnpm build && node dist/cli.js --runner minimal --suite v0.1"
  }
}
